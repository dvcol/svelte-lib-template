{
  "name": "@dvcol/svelte-lib-template",
  "type": "module",
  "version": "1.6.1",
  "packageManager": "pnpm@11.25.0",
  "description": "<description>",
  "homepage": "https://github.com/dvcol/svelte-lib-template",
  "bugs": "https://github.com/dvcol/svelte-lib-template/issues",
  "keywords": [
    "typescript",
    "library",
    "svelte",
    "svelte 5",
    "svelte-lib-template"
  ],
  "license": "MIT",
  "author": "dvcol",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvcol/svelte-lib-template.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">= 8"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "*.md",
    "LICENSE",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "prepare": "husky",
    "vite:serve": "vite --host",
    "vite:build": "vite build",
    "vite:watch": "vite build --watch",
    "vite:preview": "vite preview --host",
    "dev": "run-s vite:serve",
    "build": "run-s vite:build package",
    "build:web": "VITE_MODE=WEB run-s vite:build",
    "serve:web": "VITE_MODE=WEB run-p vite:watch vite:preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check:type": "tsc -p tsconfig.json",
    "check:type:watch": "tsc -p tsconfig.json --watch",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:svelte:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "run-s check:type check:svelte",
    "check:watch": "run-p check:type:watch check:svelte:watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "style": "stylelint **/*.{svelte,css,scss,less,html} --go '{\"gitignore\":true}'",
    "style:fix": "pnpm run style --fix",
    "test:unit": "vitest --run --coverage",
    "test:watch": "vitest",
    "release": "standard-version",
    "release:changelog": "extract-changelog-release > RELEASE.md"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "dependencies": {
    "svelte": "^5.1.9",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@dvcol/eslint-plugin-presets": "^1.3.11",
    "@dvcol/stylelint-plugin-presets": "^2.1.2",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.7.4",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.2.4",
    "@testing-library/user-event": "^14.5.2",
    "@tsconfig/node22": "^22.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/dom-view-transitions": "^1.0.5",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.0.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsonc": "^3.0.0",
    "eslint-plugin-markdown": "^5.0.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-svelte": "^3.0.0",
    "eslint-plugin-vitest": "^0.4.1",
    "eslint-plugin-yml": "^3.0.0",
    "extract-changelog-release": "^1.0.2",
    "globals": "^17.0.0",
    "husky": "^9.1.5",
    "jsdom": "^30.0.0",
    "jsonc-eslint-parser": "^3.0.0",
    "lint-staged": "^17.0.0",
    "navigation-api-types": "^0.5.1",
    "npm-run-all2": "^9.0.0",
    "postcss": "^8.4.45",
    "postcss-syntax": "^0.36.2",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^4.0.0",
    "publint": "^0.2.0",
    "sass": "^1.77.8",
    "standard-version": "^9.5.0",
    "stylelint": "^17.0.0",
    "svelte-check": "^4.0.5",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^4.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,svelte,json}": [
      "eslint --fix"
    ],
    "*.{css,scss,less,vue,svelte}": [
      "stylelint --fix"
    ]
  }
}
